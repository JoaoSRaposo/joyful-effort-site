---
/** Banner for pages shared as a review preview before publication. Remove it when the page goes live. */
interface Props {
    label: string;
    text: string;
}

const { label, text } = Astro.props;
---

<div class="bg-navy text-ivory-light" role="note">
    <p class="wrap flex flex-wrap items-baseline gap-x-3 gap-y-1 py-3 text-sm">
        <span class="eyebrow text-sunshine">{label}</span>
        <span>{text}</span>
    </p>
</div>
