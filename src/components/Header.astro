---
import { primaryButton, primaryNavigation, routes, type SiteLink } from '@/content/site';
import HandFrame from './HandFrame.astro';
import Logo from './Logo.astro';

const currentPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';

function isCurrent(href: string): boolean {
    return currentPath === href;
}

function isCurrentSection(link: SiteLink): boolean {
    return link.children?.some((child) => isCurrent(child.href)) ?? false;
}
---

<header class="sticky top-0 z-40 border-b border-transparent bg-ivory-light/95 backdrop-blur-sm" data-header>
    <div class="wrap flex items-center justify-between gap-6 py-3 md:py-4">
        <a href={routes.home} class="block w-[5.5rem] shrink-0 text-navy md:w-[6.5rem]">
            <Logo />
        </a>

        <nav aria-label="Main" class="hidden items-center gap-8 lg:flex">
            <ul class="flex items-center gap-8">
                {
                    primaryNavigation.map((link) => (
                        <li>
                            {link.children ? (
                                <details class="nav-dropdown relative" data-nav-dropdown>
                                    <summary
                                        data-current={isCurrentSection(link) ? 'true' : undefined}
                                        class="inline-flex min-h-12 cursor-pointer list-none items-center gap-1.5 font-medium underline-offset-[6px] hover:underline data-[current=true]:underline data-[current=true]:decoration-coral data-[current=true]:decoration-2 [&::-webkit-details-marker]:hidden"
                                    >
                                        {link.label}
                                        <svg class="chevron h-2.5 w-3.5 transition-transform duration-200" viewBox="0 0 14 10" fill="none" aria-hidden="true" focusable="false">
                                            <path d="M1.5 2.2 C 4 4.6, 5.6 6.4, 7.1 8 C 8.8 6.2, 10.6 4.4, 12.6 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                                        </svg>
                                    </summary>
                                    <div class="absolute top-full left-1/2 z-50 mt-2 w-64 -translate-x-1/2">
                                        <HandFrame variant={1} class="bg-ivory-light">
                                            <ul class="flex flex-col p-2">
                                                {link.children.map((child) => (
                                                    <li>
                                                        <a
                                                            href={child.href}
                                                            aria-current={isCurrent(child.href) ? 'page' : undefined}
                                                            class="flex min-h-12 items-center px-4 font-medium underline-offset-[6px] hover:underline aria-[current=page]:underline aria-[current=page]:decoration-coral aria-[current=page]:decoration-2"
                                                        >
                                                            {child.label}
                                                        </a>
                                                    </li>
                                                ))}
                                            </ul>
                                        </HandFrame>
                                    </div>
                                </details>
                            ) : (
                                <a
                                    href={link.href}
                                    aria-current={isCurrent(link.href) ? 'page' : undefined}
                                    class="inline-flex min-h-12 items-center font-medium underline-offset-[6px] hover:underline aria-[current=page]:underline aria-[current=page]:decoration-coral aria-[current=page]:decoration-2"
                                >
                                    {link.label}
                                </a>
                            )}
                        </li>
                    ))
                }
            </ul>
            <a
                href={primaryButton.href}
                class="inline-flex min-h-12 items-center bg-coral px-6 py-3 font-medium text-navy transition-colors duration-200 hover:bg-[#ff8676]"
            >
                {primaryButton.label}
            </a>
        </nav>

        <details class="mobile-menu lg:hidden" data-mobile-menu>
            <summary
                class="flex min-h-12 min-w-12 cursor-pointer list-none items-center justify-center gap-2 font-medium [&::-webkit-details-marker]:hidden"
            >
                <span class="sr-only">Menu</span>
                <svg class="h-6 w-7" viewBox="0 0 28 24" fill="none" aria-hidden="true" focusable="false">
                    <path class="menu-open" d="M2 5.5 C 10 4.8, 18 6, 26 5.2 M2 12.3 C 10 11.6, 18 12.8, 26 12 M2 19 C 10 18.4, 18 19.6, 26 18.8" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                    <path class="menu-close" d="M5 4.5 C 11 10, 17 15, 23 19.5 M23 4.5 C 17 10, 11 14.6, 5 19.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                </svg>
            </summary>
            <div class="absolute inset-x-0 top-full border-t border-navy/10 bg-ivory-light pb-8 shadow-[0_12px_24px_-16px_rgb(20_40_63/0.35)]">
                <nav aria-label="Main" class="wrap pt-4">
                    <HandFrame variant={2} class="bg-ivory-light">
                        <ul class="flex flex-col p-3">
                            {
                                primaryNavigation.map((link) => (
                                    <li>
                                        {link.children ? (
                                            <>
                                                <p class="flex min-h-14 items-center px-3 text-xl font-medium">{link.label}</p>
                                                <ul class="mb-2 ml-3 border-l-2 border-navy/15 pl-3">
                                                    {link.children.map((child) => (
                                                        <li>
                                                            <a
                                                                href={child.href}
                                                                aria-current={isCurrent(child.href) ? 'page' : undefined}
                                                                class="flex min-h-12 items-center px-3 text-lg font-medium aria-[current=page]:underline aria-[current=page]:decoration-coral aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-[6px]"
                                                            >
                                                                {child.label}
                                                            </a>
                                                        </li>
                                                    ))}
                                                </ul>
                                            </>
                                        ) : (
                                            <a
                                                href={link.href}
                                                aria-current={isCurrent(link.href) ? 'page' : undefined}
                                                class="flex min-h-14 items-center px-3 text-xl font-medium aria-[current=page]:underline aria-[current=page]:decoration-coral aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-[6px]"
                                            >
                                                {link.label}
                                            </a>
                                        )}
                                    </li>
                                ))
                            }
                        </ul>
                    </HandFrame>
                    <a
                        href={primaryButton.href}
                        class="mt-6 flex min-h-14 items-center justify-center bg-coral px-6 font-medium text-navy"
                    >
                        {primaryButton.label}
                    </a>
                </nav>
            </div>
        </details>
    </div>
</header>

<style>
    .mobile-menu .menu-close {
        display: none;
    }

    .mobile-menu[open] .menu-close {
        display: inline;
    }

    .mobile-menu[open] .menu-open {
        display: none;
    }

    .nav-dropdown[open] .chevron {
        transform: rotate(180deg);
    }
</style>

<script>
    const header = document.querySelector<HTMLElement>('[data-header]');
    const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
    const dropdowns = document.querySelectorAll<HTMLDetailsElement>('[data-nav-dropdown]');

    for (const dropdown of dropdowns) {
        dropdown.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && dropdown.open) {
                dropdown.open = false;
                dropdown.querySelector('summary')?.focus();
            }
        });

        dropdown.addEventListener('focusout', (event) => {
            if (!dropdown.contains(event.relatedTarget as Node | null)) {
                dropdown.open = false;
            }
        });
    }

    document.addEventListener('click', (event) => {
        for (const dropdown of dropdowns) {
            if (dropdown.open && !dropdown.contains(event.target as Node)) {
                dropdown.open = false;
            }
        }
    });

    if (header) {
        const onScroll = (): void => {
            header.classList.toggle('border-navy/10', window.scrollY > 8);
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
    }

    if (menu) {
        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && menu.open) {
                menu.open = false;
                menu.querySelector('summary')?.focus();
            }
        });

        window.matchMedia('(min-width: 64rem)').addEventListener('change', (query) => {
            if (query.matches) {
                menu.open = false;
            }
        });
    }
</script>
