---
/**
 * Image-led card (concepts 01/02): framed illustration on a warm ivory panel,
 * followed by a heading and a short description.
 */
import type { SiteLink } from '@/content/site';
import Arrow from './Arrow.astro';
import HandFrame from './HandFrame.astro';
import Illustration from './Illustration.astro';

interface Props {
    heading: string;
    text: string;
    illustration: string;
    variant?: number;
    link?: SiteLink;
    level?: 'h3' | 'h4';
}

const { heading, text, illustration, variant = 0, link, level = 'h3' } = Astro.props;
const Heading = level;
---

<article class="group flex h-full flex-col">
    <div class="bg-ivory-warm p-4 md:p-5">
        <HandFrame variant={variant}>
            <div class="flex aspect-[4/3] items-center justify-center p-6 md:p-8">
                <Illustration name={illustration} class="max-h-full max-w-[13.5rem]" />
            </div>
        </HandFrame>
    </div>
    <Heading class="h3 mt-6">{heading}</Heading>
    <p class="mt-3">{text}</p>
    {
        link && (
            <a
                href={link.href}
                class="mt-4 inline-flex min-h-12 items-center gap-2 font-medium underline-offset-[6px] hover:underline"
            >
                {link.label}
                <Arrow class="transition-transform duration-200 group-hover:translate-x-0.5 motion-reduce:transform-none" />
            </a>
        )
    }
</article>
