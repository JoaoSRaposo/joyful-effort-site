---
/** Confirmation page shown after a form submits without JavaScript. */
import type { SiteLink } from '@/content/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ComingSoon from './ComingSoon.astro';
import LinkRow from './LinkRow.astro';
import Section from './Section.astro';

interface Props {
    title: string;
    confirmation: string;
    back: SiteLink;
}

const { title, confirmation, back } = Astro.props;
---

<BaseLayout title={title} description={confirmation} noindex>
    <Section tone="light" innerClass="max-w-[48rem]">
        <h1 class="h2">{title}</h1>
        <ComingSoon text={confirmation} tone="warm" class="mt-8" />
        <LinkRow links={[back]} allText class="mt-8" />
    </Section>
</BaseLayout>
