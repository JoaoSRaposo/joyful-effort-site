---
import ComingSoon from '@/components/ComingSoon.astro';
import FaqItem from '@/components/FaqItem.astro';
import HandFrame from '@/components/HandFrame.astro';
import HandRule from '@/components/HandRule.astro';
import Illustration from '@/components/Illustration.astro';
import LinkRow from '@/components/LinkRow.astro';
import Section from '@/components/Section.astro';
import SplitHero from '@/components/SplitHero.astro';
import StoryRow from '@/components/StoryRow.astro';
import TextBlock from '@/components/TextBlock.astro';
import { projectLotus } from '@/content/project-lotus';
import BaseLayout from '@/layouts/BaseLayout.astro';

const { faq } = projectLotus;
---

<BaseLayout
    title="Project Lotus"
    description="Lotus is a platform that brings centre administration together with a shared network for discovering teachings and events."
>
    <SplitHero
        heading={projectLotus.hero.heading}
        highlight="Dharma"
        paragraphs={projectLotus.hero.paragraphs}
        links={projectLotus.hero.links}
    >
        <HandFrame slot="media" offset variant={2} class="bg-ivory-warm">
            <div class="flex aspect-[4/3] items-center justify-center p-10">
                <Illustration name="laptop-admin" class="max-w-[16rem]" loading="eager" />
            </div>
        </HandFrame>
    </SplitHero>

    <Section tone="warm">
        <TextBlock
            heading={projectLotus.onePlatform.heading}
            paragraphs={projectLotus.onePlatform.paragraphs}
            class="max-w-[44rem]"
        />
        <div class="mt-10 grid gap-10 sm:grid-cols-2 md:mt-14 lg:grid-cols-4 lg:gap-8">
            {
                projectLotus.onePlatform.features.map((feature, index) => (
                    <article class="flex flex-col">
                        <div class="bg-ivory-light p-4">
                            <HandFrame variant={index}>
                                <div class="flex aspect-[4/3] items-center justify-center p-6">
                                    <Illustration name={feature.illustration} class="max-h-full max-w-[10rem]" />
                                </div>
                            </HandFrame>
                        </div>
                        <h3 class="h3 mt-6">{feature.heading}</h3>
                        <p class="mt-3">{feature.text}</p>
                    </article>
                ))
            }
        </div>
    </Section>

    <StoryRow
        eyebrow={projectLotus.discoveryLabel}
        heading={projectLotus.discovery.heading}
        paragraphs={projectLotus.discovery.paragraphs}
        illustration="meditation"
        variant={0}
    />

    <StoryRow
        tone="warm"
        reverse
        heading={projectLotus.teamwork.heading}
        paragraphs={projectLotus.teamwork.paragraphs}
        illustration="volunteers"
        variant={1}
    />

    <Section tone="light" innerClass="grid items-center gap-10 md:grid-cols-2 md:gap-16">
        <TextBlock heading={projectLotus.inPractice.heading} paragraphs={projectLotus.inPractice.paragraphs} />
        <ComingSoon text={projectLotus.inPractice.comingSoon} />
    </Section>

    <Section tone="navy">
        <TextBlock
            heading={projectLotus.gettingStarted.heading}
            paragraphs={projectLotus.gettingStarted.paragraphs}
            links={projectLotus.gettingStarted.links}
            tone="ivory"
            class="max-w-[44rem]"
        />
    </Section>

    <StoryRow
        id="funding-and-costs"
        eyebrow={projectLotus.costsLabel}
        heading={projectLotus.costs.heading}
        paragraphs={projectLotus.costs.paragraphs}
        illustration="generosity"
        variant={2}
    />

    <Section tone="warm" id="faq">
        <div class="grid gap-10 lg:grid-cols-[4fr_8fr] lg:gap-16">
            <div>
                <TextBlock heading={faq.heading} paragraphs={[faq.intro]} />
                <Illustration name="prayer-book" class="mt-8 hidden w-36 lg:block" />
            </div>
            <div>
                {
                    faq.groups.map((group, groupIndex) => (
                        <div class:list={[groupIndex > 0 && 'mt-12']}>
                            {group.label && <p class="eyebrow mb-4">{group.label}</p>}
                            <div class="relative">
                                {group.items.map((item, index) => (
                                    <FaqItem
                                        question={item.question}
                                        answer={item.answer}
                                        links={item.links}
                                        variant={index}
                                    />
                                ))}
                                <HandRule class="bottom-0 left-0" variant={1} />
                            </div>
                        </div>
                    ))
                }

                <div class="mt-14">
                    <h2 id="still-have-a-question" class="h3">{faq.stillHaveAQuestion.heading}</h2>
                    <p class="mt-3 max-w-[36rem]">{faq.stillHaveAQuestion.text}</p>
                    <LinkRow links={[faq.stillHaveAQuestion.link]} class="mt-6" />
                </div>
            </div>
        </div>
    </Section>
</BaseLayout>
