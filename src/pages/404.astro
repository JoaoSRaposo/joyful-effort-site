---
import Illustration from '@/components/Illustration.astro';
import LinkRow from '@/components/LinkRow.astro';
import Section from '@/components/Section.astro';
import { primaryNavigation, routes } from '@/content/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page could not be found." noindex>
    <Section tone="light" innerClass="grid items-center gap-10 md:grid-cols-2 md:min-h-[50vh]">
        <div>
            <h1 class="h1">Page not found</h1>
            <LinkRow links={[{ label: 'Joyful Effort', href: routes.home }, ...primaryNavigation]} class="mt-8" />
        </div>
        <Illustration name="meditation" class="mx-auto w-48 md:w-60" loading="eager" />
    </Section>
</BaseLayout>
