---
import ContactForm from '@/components/ContactForm.astro';
import FormField from '@/components/FormField.astro';
import HandFrame from '@/components/HandFrame.astro';
import Illustration from '@/components/Illustration.astro';
import Section from '@/components/Section.astro';
import TextBlock from '@/components/TextBlock.astro';
import { inquire } from '@/content/inquire';
import { routes } from '@/content/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
    title={inquire.heading}
    description="Send Joyful Effort a question about Joyma or an idea you would like to share."
>
    <Section tone="light" innerClass="grid gap-10 lg:grid-cols-[5fr_7fr] lg:gap-16">
        <div>
            <TextBlock
                heading={inquire.heading}
                paragraphs={[...inquire.paragraphs, inquire.centerPointer.text]}
                links={[{ label: inquire.centerPointer.label, href: routes.centerInquiry }]}
                allTextLinks
                level="h1"
            />
            <Illustration name="communications" class="mt-10 w-32 md:w-40" loading="eager" />
        </div>
        <HandFrame variant={0} offset class="bg-ivory-light">
            <div class="p-6 md:p-10">
                <ContactForm action="/api/inquiry" submitLabel={inquire.submit} confirmation={inquire.confirmation}>
                    <div class="grid gap-8 sm:grid-cols-2 sm:gap-4">
                        <FormField name="name" label={inquire.fields.name.label} required autocomplete="name" />
                        <FormField
                            name="email"
                            label={inquire.fields.email.label}
                            type="email"
                            required
                            autocomplete="email"
                        />
                    </div>
                    <FormField
                        name="organization"
                        label={inquire.fields.organization.label}
                        hint={inquire.fields.organization.hint}
                        optional
                        autocomplete="organization"
                    />
                    <FormField
                        name="message"
                        type="textarea"
                        label={inquire.fields.message.label}
                        hint={inquire.fields.message.hint}
                        required
                    />
                </ContactForm>
            </div>
        </HandFrame>
    </Section>
</BaseLayout>
