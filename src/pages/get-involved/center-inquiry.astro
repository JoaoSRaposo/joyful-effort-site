---
import CheckboxGroup from '@/components/CheckboxGroup.astro';
import ContactForm from '@/components/ContactForm.astro';
import FormField from '@/components/FormField.astro';
import HandFrame from '@/components/HandFrame.astro';
import Illustration from '@/components/Illustration.astro';
import Section from '@/components/Section.astro';
import TextBlock from '@/components/TextBlock.astro';
import { centerInquiry } from '@/content/center-inquiry';
import { routes } from '@/content/site';
import BaseLayout from '@/layouts/BaseLayout.astro';

const { fields } = centerInquiry;
---

<BaseLayout
    title={centerInquiry.heading}
    description="Tell us about your center, what’s working well and where you could use some support."
>
    <Section tone="light" innerClass="grid gap-10 lg:grid-cols-[5fr_7fr] lg:gap-16">
        <div>
            <TextBlock
                eyebrow={centerInquiry.eyebrow}
                heading={centerInquiry.heading}
                paragraphs={[...centerInquiry.paragraphs, centerInquiry.generalPointer.text]}
                links={[{ label: centerInquiry.generalPointer.label, href: routes.inquire }]}
                allTextLinks
                level="h1"
                size="h2"
            />
            <Illustration name="meditation" class="mt-10 w-32 md:w-40" loading="eager" />
        </div>
        <HandFrame variant={0} offset class="bg-ivory-light">
            <div class="p-6 md:p-10">
                <ContactForm
                    action="/api/center-inquiry"
                    submitLabel={centerInquiry.submit}
                    confirmation={centerInquiry.confirmation}
                >
                    <div class="grid gap-8 sm:grid-cols-2 sm:gap-4">
                        <FormField
                            name="center_name"
                            label={fields.centerName.label}
                            required
                            autocomplete="organization"
                        />
                        <FormField name="country" label={fields.country.label} required autocomplete="country-name" />
                    </div>
                    <FormField
                        name="website_url"
                        type="url"
                        label={fields.websiteUrl.label}
                        optional
                        autocomplete="url"
                        maxlength={500}
                    />
                    <div class="grid gap-8 sm:grid-cols-2 sm:gap-4">
                        <FormField name="contact_name" label={fields.contactName.label} required autocomplete="name" />
                        <FormField
                            name="role"
                            label={fields.role.label}
                            optional
                            autocomplete="organization-title"
                        />
                    </div>
                    <FormField name="email" type="email" label={fields.email.label} required autocomplete="email" />
                    <CheckboxGroup
                        name="center_types"
                        legend={fields.centerTypes.label}
                        hint={fields.centerTypes.hint}
                        options={fields.centerTypes.options}
                    />
                    <CheckboxGroup
                        name="areas_of_interest"
                        legend={fields.areasOfInterest.label}
                        hint={fields.areasOfInterest.hint}
                        options={fields.areasOfInterest.options}
                    />
                    <CheckboxGroup
                        name="current_tools"
                        legend={fields.currentTools.label}
                        hint={fields.currentTools.hint}
                        options={fields.currentTools.options}
                    />
                    <FormField
                        name="message"
                        type="textarea"
                        label={fields.message.label}
                        placeholder={fields.message.placeholder}
                        optional
                    />
                    <div class="prose-je">
                        {centerInquiry.closing.map((paragraph) => <p>{paragraph}</p>)}
                    </div>
                </ContactForm>
            </div>
        </HandFrame>
    </Section>

    <Section tone="warm">
        <TextBlock heading={centerInquiry.behind.heading} paragraphs={centerInquiry.behind.paragraphs} />
    </Section>
</BaseLayout>
