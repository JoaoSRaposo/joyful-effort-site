---
import '@fontsource-variable/mulish/wght.css';
import '@fontsource-variable/mulish/wght-italic.css';

/**
 * The Joyma Seeds hub: the home page for the pilot centers between monthly meetings.
 * It keeps the Joyma product look rather than the Joyful Effort site design, so it does not use BaseLayout.
 */
const title = 'Joyma Seeds — everything in one place';
const description =
    'Joyma Seeds: meeting times, the test environment, what to test this month, where we need your input, past presentations and contacts.';
const canonical = new URL('/seeds', Astro.site);
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="noindex" />
<link rel="canonical" href={canonical} />
<link rel="icon" href="/images/seeds/joyma-mark.png" type="image/png" />
<style is:global>
  /* Tokens lifted from lotus/resources/css/app.css */
  :root{
    --site-background:#ffffff; --background:#fdfaff; --foreground:#1a0f20;
    --text:#242124; --text-muted:#6b666b;
    --card:#ffffff;
    --primary:#a24a89; --primary-foreground:#ffffff;
    --secondary:#f3e7f1; --secondary-foreground:#6f356d;
    --muted:#f3eee3; --muted-foreground:#8a6898;
    --border:rgba(162,74,137,.14);
    --rule:rgba(162,74,137,.22);
    --heading:#a24a89; --brand-deep:#6d3285; --brand-tint:#f4daff;
    --band-alt:#faf3f8;
    --warning-subtle:#fde9b0; --warning-subtle-fg:#7a4e10;
    --chart-4:#7a9c72; --chart-5:#d5a642;
    --radius:.875rem; --radius-sm:.75rem;
    --shadow-card:0 1px 2px rgba(26,15,32,.05);
    --shadow-bar:0 2px 6px -4px rgba(0,0,0,.16);
    --font-sans:"Mulish Variable",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
  body{
    font-family:var(--font-sans);background:var(--site-background);color:var(--text);
    font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;
  }
  img{max-width:100%}

  /* ============ sticky white header, as on stage ============ */
  .topbar{
    position:sticky;top:0;z-index:40;background:rgba(255,255,255,.92);
    border-bottom:1px solid rgba(162,74,137,.1);
    box-shadow:var(--shadow-bar);backdrop-filter:blur(8px);
  }
  .bar{
    max-width:1180px;margin:0 auto;padding:10px 24px;
    display:flex;align-items:center;justify-content:space-between;gap:10px 18px;
    min-height:80px;flex-wrap:wrap;
  }
  .logo{display:flex;align-items:center;gap:9px;text-decoration:none;flex:none}
  .logo img{width:52px;height:auto;display:block}
  .logo span{font-size:28px;font-weight:800;color:var(--primary);letter-spacing:-.02em;line-height:1}
  .topnav{display:flex;align-items:center;gap:4px;flex-wrap:wrap}
  .topnav a{
    color:var(--foreground);text-decoration:none;font-size:15px;font-weight:600;
    padding:8px 12px;border-radius:9px;transition:.15s;white-space:nowrap;
  }
  .topnav a:hover{background:var(--secondary);color:var(--secondary-foreground)}
  .topnav a.accent{color:var(--primary)}
  .topnav a.current{background:var(--secondary);color:var(--secondary-foreground)}

  /* ============ bands: each section is its own full width block ============ */
  .band{padding:76px 0;border-top:1px solid var(--rule);scroll-margin-top:81px}
  .band--alt{background:var(--band-alt)}
  .wrap{max-width:1180px;margin:0 auto;padding:0 24px}

  /* ============ hero ============ */
  .hero{
    padding:56px 0 60px;
    background:linear-gradient(180deg,var(--brand-tint) 0%,#fdf6fb 55%,var(--site-background) 100%);
    border-bottom:1px solid var(--rule);
  }
  h1{
    font-size:clamp(34px,5vw,50px);font-weight:800;color:var(--heading);
    letter-spacing:-.025em;line-height:1.08;margin-bottom:14px;
  }
  .hero .sub{font-size:16.5px;color:var(--text-muted);max-width:72ch}
  .hero .sub + .sub{margin-top:10px}
  .hero .stamp{
    display:inline-flex;align-items:center;gap:8px;margin-top:20px;
    background:#fff;border:1px solid var(--border);border-radius:999px;
    padding:7px 15px;font-size:13.5px;font-weight:600;color:var(--secondary-foreground);
  }
  .hero .stamp svg{width:15px;height:15px;stroke:var(--primary);fill:none;stroke-width:1.8}

  /* ============ section headers ============ */
  .sechead{margin-bottom:30px;padding-bottom:22px;border-bottom:2px solid var(--rule)}
  .eyebrow{display:flex;align-items:center;gap:12px;margin-bottom:14px}
  
  .secnum{
    display:inline-flex;align-items:center;justify-content:center;flex:none;
    width:28px;height:28px;border-radius:9px;background:var(--primary);color:#fff;
    font-size:13px;font-weight:800;letter-spacing:0;
  }
  h2{
    font-size:clamp(27px,3.6vw,36px);font-weight:800;color:var(--heading);
    letter-spacing:-.022em;line-height:1.12;margin-bottom:10px;
  }
  .sechead h2:last-child{margin-bottom:0}
  .sechead .sub{font-size:16px;color:var(--text-muted);max-width:78ch}
  .sechead .sub + .sub{margin-top:9px}

  /* a small label above a group inside a section */
  .subhead{
    font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.12em;
    color:var(--primary);margin:0 0 12px;
  }

  /* grouped topic inside a section */
  .topic{margin-bottom:26px}
  .topic:last-child{margin-bottom:0}

  /* ============ cards ============ */
  .grid{display:grid;gap:20px}
  .g2{grid-template-columns:repeat(2,1fr)}
  .g3{grid-template-columns:repeat(3,1fr)}
  .card{
    background:var(--card);border:1px solid var(--border);border-radius:var(--radius-sm);
    box-shadow:var(--shadow-card);overflow:hidden;display:flex;flex-direction:column;
  }
  .card .body{padding:22px 24px;display:flex;flex-direction:column;flex:1}
  .card h3{
    font-size:20px;font-weight:800;color:var(--foreground);
    letter-spacing:-.015em;line-height:1.25;margin-bottom:10px;
  }
  .card h4{
    font-size:17.5px;font-weight:800;color:var(--heading);
    letter-spacing:-.01em;line-height:1.25;margin:22px 0 8px;
    padding-top:18px;border-top:1px solid var(--border);
  }
  .card h4:first-child{margin-top:0;padding-top:0;border-top:0}
  .card p{font-size:15.5px;color:var(--text-muted)}
  .card p + p{margin-top:10px}
  .card p strong{color:var(--foreground);font-weight:700}
  .card.tint{background:var(--secondary);border-color:rgba(162,74,137,.2)}
  .card.tint h3{color:var(--brand-deep)}
  .card.tint p{color:var(--secondary-foreground)}
  .card.sand{background:var(--warning-subtle);border-color:rgba(213,166,66,.4)}
  .card.sand h3,.card.sand p{color:var(--warning-subtle-fg)}
  .card.sand p strong{color:var(--warning-subtle-fg)}

  /* media block, the cream lotus placeholder used on stage event cards */
  .media{
    background:var(--muted);height:180px;display:flex;align-items:center;justify-content:center;
    border-bottom:1px solid var(--border);
  }
  .media img{width:180px;opacity:.92}

  /* ============ badges ============ */
  .badges{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}
  .badge{
    display:inline-flex;align-items:center;font-size:13px;font-weight:600;line-height:1;
    padding:7px 13px;border-radius:999px;border:1px solid var(--border);
    background:#fff;color:var(--text-muted);white-space:nowrap;
  }
  .badge.soft{background:var(--secondary);color:var(--secondary-foreground);border-color:transparent}
  .badge.solid{background:var(--primary);color:var(--primary-foreground);border-color:transparent;font-weight:700}
  .badge.sand{background:var(--warning-subtle);color:var(--warning-subtle-fg);border-color:transparent}

  /* ============ meta rows ============ */
  .meta{margin-top:auto;padding-top:16px;display:flex;flex-direction:column;gap:8px}
  .meta div{display:flex;align-items:center;gap:9px;font-size:14.5px;color:var(--text-muted)}
  .meta svg{width:16px;height:16px;flex:none;stroke:var(--muted-foreground);fill:none;stroke-width:1.7}

  /* ============ links & buttons ============ */
  a{color:var(--primary);font-weight:600}
  .prose a{text-decoration:underline;text-underline-offset:3px}
  .prose a:hover{text-decoration:none}
  .actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:16px}
  .btn{
    display:inline-flex;align-items:center;gap:7px;text-decoration:none;font-size:14.5px;font-weight:700;
    border-radius:10px;padding:10px 16px;border:1px solid var(--border);
    background:#fff;color:var(--primary);transition:.15s;
  }
  .btn:hover{background:var(--secondary);border-color:var(--primary)}
  .btn.solid{background:var(--primary);color:#fff;border-color:var(--primary)}
  .btn.solid:hover{background:var(--brand-deep);border-color:var(--brand-deep)}
  .btn svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:1.8}

  /* ============ meeting times ============ */
  .tzrow{display:flex;flex-wrap:wrap;gap:8px}
  .tz{
    background:var(--secondary);border-radius:999px;padding:7px 14px;
    font-size:14px;color:var(--secondary-foreground);white-space:nowrap;
  }
  .tz b{font-weight:800}
  .meet-join{margin:16px 0 24px}

  /* ============ lists ============ */
  .kinds{
    margin:20px 0 0;padding-left:1.15em;color:var(--text-muted);
    font-size:15.5px;max-width:80ch;
  }
  .kinds li + li{margin-top:8px}
  .kinds li::marker{color:var(--primary)}
  .kinds strong{color:var(--foreground);font-weight:700}

  /* ============ table ============ */
  .tw{overflow-x:auto;-webkit-overflow-scrolling:touch;
    border:1px solid var(--border);border-radius:var(--radius-sm);background:#fff;
    box-shadow:var(--shadow-card)}
  table{width:100%;border-collapse:collapse;font-size:15.5px}
  th{
    text-align:left;background:var(--muted);color:var(--brand-deep);font-size:11.5px;font-weight:800;
    text-transform:uppercase;letter-spacing:.1em;padding:13px 20px;white-space:nowrap;
  }
  td{padding:14px 20px;border-top:1px solid var(--border);vertical-align:middle;color:var(--text-muted)}
  td strong{color:var(--foreground);font-weight:700}
  td .badge{margin-right:8px}
  td.nw{white-space:nowrap}
  td code{
    background:var(--secondary);border-radius:7px;padding:3px 9px;font-size:13.5px;
    font-family:ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--secondary-foreground);
  }

  /* ============ callouts ============ */
  .callout{
    border-radius:var(--radius-sm);padding:16px 20px;font-size:15.5px;margin-top:20px;
    background:var(--secondary);color:var(--secondary-foreground);border:1px solid rgba(162,74,137,.16);
  }
  .callout.sand{background:var(--warning-subtle);color:var(--warning-subtle-fg);border-color:rgba(213,166,66,.4)}
  .callout a{color:inherit;text-decoration:underline;text-underline-offset:3px}
  .callout strong{font-weight:800}
  .note{margin-top:16px;font-size:15.5px;color:var(--text-muted);max-width:80ch}

  footer{
    border-top:1px solid var(--rule);background:#fff;
  }
  .footin{
    max-width:1180px;margin:0 auto;padding:30px 24px 40px;text-align:center;
    color:var(--text-muted);font-size:14px;line-height:1.9;
  }
  .footin .mark{width:40px;margin:0 auto 10px;display:block;opacity:.85}

  /* the longer nav labels need a little less room on mid-size screens */
  @media (max-width:1000px){
    .topnav a{font-size:13.5px;padding:7px 9px}
  }
  @media (max-width:900px){
    .g3{grid-template-columns:1fr 1fr}
  }
  @media (max-width:760px){
    .bar{padding:14px 18px;justify-content:center}
    .topnav{justify-content:center;gap:2px}
    .topnav a{font-size:14px;padding:7px 10px}
    .wrap{padding:0 18px}
    .hero{padding:34px 0 40px}
    .band{padding:48px 0;scroll-margin-top:130px}
    .g2,.g3{grid-template-columns:1fr}
  }
</style>
</head>
<body>
<div class="topbar">
  <div class="bar">
    <a class="logo" href="#top" aria-label="Joyma Seeds home">
      <img src="/images/seeds/joyma-mark.png" alt="">
      <span>joyma</span>
    </a>
    <nav class="topnav">
      <a href="#dates">Upcoming meetings</a>
      <a href="#testing">Test environment</a>
      <a href="#do">What to test</a>
      <a href="#questions">Your input</a>
      <a href="#roadmap">Roadmap</a>
      <a href="#meetings">Previous sessions</a>
      <a href="#contact" class="accent">Contact</a>
    </nav>
  </div>
</div>

<main id="top">

  <!-- ============ HERO ============ -->
  <div class="hero">
    <div class="wrap">
      <h1>Joyma Seeds</h1>
      <p class="sub">Hello, dear pilot centers. Thank you for everything you are contributing to this project &mdash; your time, insights, requests and feedback. That is what will make this platform useful for as many dharma centers as possible.</p>
      <p class="sub prose"><strong>Lotus has a new name: Joyma.</strong> Same platform, same team, same Seeds program &mdash; only the name has changed. You can find it at <a href="https://joyma.co" target="_blank" rel="noopener">joyma.co</a>. Your test environment logins stay the same; the monthly meeting has a <a href="#dates">new link</a> from December.</p>
      <p class="sub prose">Each monthly meeting is where we demo updates and new features. This page is your hub in between: <a href="#do">what to test</a>, and <a href="#questions">where we still need your input</a>, so your feedback can go on that month's list and be built &mdash; or at least addressed &mdash; when we meet next. You'll also find meeting times, past presentations, and how to get in.</p>
      <span class="stamp">
        <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 11h18"/></svg>
        Updated 7 November 2026
      </span>
    </div>
  </div>

  <!-- ============ 01 · UPCOMING MEETINGS ============ -->
  <section class="band" id="dates">
    <div class="wrap">
      <header class="sechead">
        <div class="eyebrow"><span class="secnum">1</span> <h2>Monthly Meeting: every 1st Wednesday</h2> </div>
        
      </header>

      <div class="tzrow">
        <span class="tz"><b>16:00</b> London &middot; Lisbon</span>
        <span class="tz"><b>17:00</b> Paris &middot; Madrid</span>
        <span class="tz"><b>11:00</b> New York</span>
        <span class="tz"><b>09:00</b> Santa Fe</span>
      </div>

      <p class="note prose">From December the meeting has a new link, below. The time stays the same, and every session is recorded.</p>

      <div class="actions meet-join">
        <a class="btn solid" href="https://greet.metaprovide.org/joyma-seeds" target="_blank" rel="noopener"><svg viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg> greet.metaprovide.org/joyma-seeds</a>
      </div>

      <div class="tw">
        <table>
          <thead><tr><th>Session</th><th>Date</th></tr></thead>
          <tbody>
            <tr><td><span class="badge solid">Next</span> Session 6</td><td><strong>Wednesday 2 December 2026</strong></td></tr>
            <tr><td>Session 7</td><td><strong>Wednesday 6 January 2027</strong></td></tr>
            <tr><td>Session 8</td><td><strong>Wednesday 3 February 2027</strong></td></tr>
            <tr><td>Session 9</td><td><strong>Wednesday 3 March 2027</strong></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============ 02 · TEST ENVIRONMENT ============ -->
  <section class="band band--alt" id="testing">
    <div class="wrap">
      <header class="sechead">
        <div class="eyebrow"><span class="secnum">2</span><h2>Test environment</h2></div>
        
        <p class="sub prose"><a href="https://stage.joyma.co/admin" target="_blank" rel="noopener">stage.joyma.co/admin</a> is where you work.</p>
        <p class="sub prose"><a href="https://stage.joyma.co/" target="_blank" rel="noopener">stage.joyma.co</a> is what participants will see.</p>
        <p class="sub prose">This is a safe environment to experiment. It is not connected to the outside world &mdash; payments and registration confirmations are pretend.</p>
      </header>

      <div class="tw">
        <table>
          <thead><tr><th>Center</th><th>Country</th><th>Center admin login</th></tr></thead>
          <tbody>
            <tr><td><strong>Jamyang Buddhist Centre London</strong></td><td>United Kingdom</td><td><code>jamyang-admin@lotus.test</code></td></tr>
            <tr><td><strong>Institut Vajra Yogini</strong> (IVY)</td><td>France</td><td><code>ivy-admin@lotus.test</code></td></tr>
            <tr><td><strong>Thubten Norbu Ling</strong> (TNL)</td><td>United States</td><td><code>tnl-admin@lotus.test</code></td></tr>
            <tr><td><strong>Shantideva</strong></td><td>United States</td><td><code>shantideva-admin@lotus.test</code></td></tr>
            <tr><td><span class="badge solid">New</span> <strong>Chandrakirti Meditation Centre</strong></td><td>New Zealand</td><td><code>chandrakirti-admin@lotus.test</code></td></tr>
          </tbody>
        </table>
      </div>

      <ul class="kinds">
        <li><strong>Center admin</strong> &mdash; the logins in the table. One per center.</li>
        <li><strong>Team member</strong> &mdash; from the admin panel, add other staff if they are testing too.</li>
        <li><strong>Participant</strong> &mdash; on the public site, register with any email you control to walk through as a student. The center admin can do this too.</li>
      </ul>

      <div class="callout"><strong>Need a password reminder, or a login that isn&rsquo;t listed?</strong> Ask Jo&atilde;o or Lauren in the <a href="https://galaxy.metaprovide.org/call/xzfrt5aj" target="_blank" rel="noopener">Seeds channel</a>.</div>
    </div>
  </section>

  <!-- ============ 03 · WHAT TO TEST ============ -->
  <section class="band" id="do">
    <div class="wrap">
      <header class="sechead">
        <div class="eyebrow"><span class="secnum">3</span><h2>What to test</h2></div>
        
      </header>

      <div class="card sand">
        <div class="body">
          <div class="badges"><span class="badge sand">Paused</span></div>
          <h3>Structured testing is paused while we work on UX</h3>
          <p>Maile, our UI/UX designer, is redesigning the admin experience first &mdash; creating events and memberships &mdash; and then the participant side. Testing those screens now would mean testing something that is about to change.</p>
          <p>Instead, tell us <strong>your main pain points</strong> in <a href="#questions">Your input</a>. The one thing still worth trying is <strong>checkout and Stripe</strong> &mdash; that is your easiest way to start taking payments.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 04 · YOUR INPUT ============ -->
  <section class="band band--alt" id="questions">
    <div class="wrap">
      <header class="sechead">
        <div class="eyebrow"><span class="secnum">4</span><h2>Your input</h2></div>
        
        <p class="sub prose">Areas where we need your additional input. Each center's situation will differ. A rough reply is plenty. Please reply in the <a href="https://galaxy.metaprovide.org/call/xzfrt5aj" target="_blank" rel="noopener">Galaxy channel</a>.</p>
      </header>

      <div class="topic">
        <div class="subhead">Your main pain points</div>
        <div class="card tint">
          <div class="body">
            <h3>What is the one big thing?</h3>
            <p>Tell us your main pain points with Joyma so far. <strong>If you have a very specific or very big need &mdash; the main change that would make the software work for your center &mdash; let us know what it is</strong>, so we can factor it in.</p>
            <p>Everything you send here goes to Maile for the UX work, and we will make sure it is included.</p>
          </div>
        </div>
      </div>

      <div class="topic">
        <div class="subhead">Payments &middot; priority</div>
        <div class="card">
          <div class="body">
            <h4>Test checkout and Stripe</h4>
            <p>This is the most useful thing to test right now: it is your easy way to start taking payments. Connect your center&rsquo;s Stripe test account from the admin, then pay for a registration at checkout. Nothing is really charged: click the small <strong>Stripe button at the bottom right</strong> of the checkout page and choose the successful Visa test card (4242).</p>
            <p><strong>Was anything at checkout unclear, slow, or not trustworthy?</strong> Whatever confuses you will confuse your participants.</p>
            <p>No center has connected its Stripe account yet. <strong>Who at your center manages Stripe, and what is in the way?</strong> If you need a hand, ping Jo&atilde;o and we will set it up together.</p>
          </div>
        </div>
      </div>

      <div class="topic">
        <div class="subhead">Reporting</div>
        <div class="card">
          <div class="body">
            <h4>Your tables</h4>
            <p>Look at the tables in the admin backend &mdash; events, registrations, people, memberships. <strong>Which fields or filters would let you export exactly the information you need?</strong></p>
            <p>Be specific: the column your treasurer asks for, the filter you would use every Monday morning, the thing you currently rebuild by hand in a spreadsheet.</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ============ 05 · ROADMAP ============ -->
  <section class="band" id="roadmap">
    <div class="wrap">
      <header class="sechead">
        <div class="eyebrow"><span class="secnum">5</span><h2>Roadmap</h2></div>
        <p class="sub">What we have built together so far, and what comes next. The order of the gates is the commitment; dates firm up as each gate before it closes.</p>
      </header>

      <div class="topic">
        <div class="subhead">Delivered</div>
        <div class="tw">
          <table>
            <thead><tr><th>Gate</th><th>Status</th><th>What it covers</th></tr></thead>
            <tbody>
              <tr><td class="nw"><strong>Gate A</strong></td><td class="nw"><span class="badge soft">Done</span></td><td><strong>Events &amp; registration</strong> &mdash; events, sessions, recurring events, registration and check-in.</td></tr>
              <tr><td class="nw"><strong>Gate B</strong></td><td class="nw"><span class="badge soft">Done</span></td><td><strong>Courses &amp; members</strong> &mdash; Moodle with single sign-in, and the membership foundation.</td></tr>
